---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import themeScript from '../scripts/theme.js?raw';
import { siteConfig } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = siteConfig.author.photo,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, siteConfig.site).toString();
const socialImage = new URL(image, siteConfig.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f5f0" />
    <script is:inline set:html={themeScript} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href="/rss.xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          // The previous Gatsby site shipped an offline worker. Unregister it on first load so
          // the rebuilt site is not served stale cached assets.
          navigator.serviceWorker.getRegistrations().then((registrations) => {
            registrations.forEach((registration) => registration.unregister());
          });
        });
      }
    </script>
    <main class="page-shell" id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-top">
          <div>
            <a class="wordmark" href="/" aria-label={`${siteConfig.title} — home`}>zhong<span>.</span></a>
            <p class="footer-note">A few things learned along the way.</p>
          </div>
          <nav class="footer-links" aria-label="Elsewhere">
            <a href={siteConfig.author.github}>GitHub <span aria-hidden="true">↗</span></a>
            <a href={`mailto:${siteConfig.author.email}`}>Email <span aria-hidden="true">↗</span></a>
            <a href="/rss.xml">RSS <span aria-hidden="true">↗</span></a>
          </nav>
        </div>
        <div class="footer-bottom eyebrow">
          <p>© {new Date().getUTCFullYear()} {siteConfig.author.name}</p>
          <a href="#top">Back to top ↑</a>
        </div>
      </div>
    </footer>
  </body>
</html>
