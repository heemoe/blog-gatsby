---
import { type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPostUrl, getPublishedPosts } from '../../lib/content';
import { siteConfig } from '../../site.config';
import '../../styles/reading.css';

interface Props {
  post: CollectionEntry<'blog'>;
  earlierPost: CollectionEntry<'blog'> | null;
}

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: { post, earlierPost: posts[index + 1] ?? null },
  }));
}

const { post, earlierPost } = Astro.props;
const { Content } = await post.render();
const publishedAt = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout
  title={`${post.data.title} - ${siteConfig.title}`}
  description={post.data.description || siteConfig.description}
  image={post.data.heroImage}
>
  <article class="reading-page">
    <header class="reading-header">
      <a class="text-link reading-back" href="/">
        <span aria-hidden="true">←</span> Writing
      </a>
      <p class="eyebrow reading-header__label">From the notebook</p>
      <h1 class="reading-title">{post.data.title}</h1>
    </header>

    <div class="reading-grid">
      <aside class="reading-meta" aria-label="Article details">
        <dl>
          <div>
            <dt class="eyebrow">Published</dt>
            <dd><time datetime={post.data.date.toISOString()}>{publishedAt}</time></dd>
          </div>
          {
            post.data.tags.length > 0 && (
              <div>
                <dt class="eyebrow">Filed under</dt>
                <dd>
                  <ul class="reading-topics">
                    {post.data.tags.map((tag) => <li>{tag}</li>)}
                  </ul>
                </dd>
              </div>
            )
          }
        </dl>
      </aside>

      <div class="reading-column">
        <div class="reading-prose">
          <Content />
        </div>
        <nav class="reading-end" aria-label="More writing">
          {
            earlierPost && (
              <a class="reading-next" href={getPostUrl(earlierPost)}>
                <span class="eyebrow">Earlier note</span>
                <span class="reading-next__title">
                  {earlierPost.data.title}
                  <span aria-hidden="true">↗</span>
                </span>
              </a>
            )
          }
          <a class="text-link" href="/">All writing <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('.reading-prose pre').forEach((block, index) => {
    block.tabIndex = 0;
    block.setAttribute('role', 'region');
    block.setAttribute('aria-label', `Code example ${index + 1}`);
  });
</script>
